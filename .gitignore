# Produced by a run, not part of the toolchain.
#
# These are regenerable and they change every time a command is run, so
# tracking them buries real source changes under noise -- and a figure
# committed from one version of the model outlives the model.

# Circuits, netlists and reports
build/
test_reports/
dataset/
*.json.tmp

# Exported figures and tables. Anything under an explicit output directory
# is kept, so `--export out/fig.pdf` still works as a deliberate act.
/*.svg
/*.pdf
/*.png
/*.jpg
/*.jpeg
/*.tex
/*.tikz
/*.csv
!examples/*.csv

# Built artefacts
java/build/
java/digbridge.jar
__pycache__/
*.pyc

# Distribution archives
*.tar.gz
*.zip

# The verification record lives beside the circuits it describes, and both
# are generated.
.verified.json
