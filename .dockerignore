# Keep the build context small and deterministic. Anything generated by a
# previous run would otherwise be copied in, and a stale build/ directory
# inside the image is worse than none: `verify` would read netlists the
# image did not produce.
build/
test_reports/
dataset/
__pycache__/
*.pyc
java/build/
java/digbridge.jar
.git/
*.tar.gz
